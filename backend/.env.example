# ---------------------------------------------------------------------------
# LuxeLiving Backend — Environment Configuration
# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the service dashboard.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=production

# Comma-separated list of allowed frontend origins (Vercel URL(s) + custom domain).
# Example: https://luxeliving.vercel.app,https://www.luxeliving.in
FRONTEND_URL=http://localhost:5173

# Where the JSON data store is persisted. On Render, mount a Persistent Disk
# (e.g. at /data) and point this at it so data survives deploys/restarts.
DATA_DIR=./data

# Auth
# Generate a strong secret: `openssl rand -base64 48`
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed admin account (only used the first time the database is created).
# CHANGE THESE before deploying to production.
ADMIN_NAME="Priya Sharma"
ADMIN_EMAIL=admin@luxeliving.in
ADMIN_PASSWORD=luxe2026
